{
  "name": "sentinel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted API security and observability platform.",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/worker\" \"npm run dev -w apps/dashboard\"",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --workspaces",
    "typecheck": "tsc -b tsconfig.json",
    "format": "prettier --write ."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
